<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= (profile?.personal?.firstName || '') + ' ' + (profile?.personal?.lastName || 'Resume') %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    /* ─────────── CSS Variables ─────────── */
    :root {
      --glass-bg: rgba(255, 255, 255, 0.7);
      --glass-border: rgba(255, 255, 255, 0.25);
      --glass-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
      --primary: #4f46e5;
      --primary-light: #818cf8;
      --text-primary: #0f172a;
      --text-secondary: #475569;
      --radius: 20px;
      --transition: 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    }

    /* ─────────── Reset & Base ─────────── */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      font-family: 'Inter', sans-serif;
      background: #f1f5f9;
      color: var(--text-primary);
      line-height: 1.6;
      min-height: 100vh;
      padding: 2rem 1.5rem;
      background-image: radial-gradient(circle at 10% 20%, rgba(79, 70, 229, 0.05) 0%, transparent 50%),
                        radial-gradient(circle at 90% 80%, rgba(129, 140, 248, 0.08) 0%, transparent 60%);
      background-attachment: fixed;
    }
    .container {
      max-width: 1100px;
      margin: 0 auto;
    }

    /* ─────────── Glass card base ─────────── */
    .glass {
      background: var(--glass-bg);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid var(--glass-border);
      box-shadow: var(--glass-shadow);
      border-radius: var(--radius);
      transition: transform var(--transition), box-shadow var(--transition);
    }
    .glass:hover {
      transform: translateY(-4px);
      box-shadow: 0 16px 48px rgba(0, 0, 0, 0.1);
    }

    /* ─────────── Animations ─────────── */
    @keyframes fadeSlideUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-10px); }
    }
    @keyframes gradientShift {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }
    @keyframes growWidth {
      from { width: 0; }
    }

    .animate-in {
      opacity: 0;
      animation: fadeSlideUp 0.8s ease forwards;
    }
    .delay-1 { animation-delay: 0.1s; }
    .delay-2 { animation-delay: 0.2s; }
    .delay-3 { animation-delay: 0.3s; }
    .delay-4 { animation-delay: 0.4s; }
    .delay-5 { animation-delay: 0.5s; }

    /* ─────────── Hero ─────────── */
    .hero {
      padding: 3rem 2.5rem;
      margin-bottom: 2.5rem;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .hero::after {
      content: '';
      position: absolute;
      top: -50%;
      right: -20%;
      width: 300px;
      height: 300px;
      background: radial-gradient(circle, rgba(79, 70, 229, 0.15), transparent 70%);
      border-radius: 50%;
      pointer-events: none;
    }
    .hero-content {
      position: relative;
      z-index: 1;
    }
    .avatar {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--primary), var(--primary-light));
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.2rem;
      font-size: 3.2rem;
      color: #fff;
      font-weight: 700;
      box-shadow: 0 8px 30px rgba(79, 70, 229, 0.35);
      animation: float 4s ease-in-out infinite;
    }
    .name {
      font-size: clamp(2.2rem, 6vw, 3.8rem);
      font-weight: 800;
      letter-spacing: -0.02em;
      background: linear-gradient(135deg, #1e293b, var(--primary));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .title {
      font-size: 1.3rem;
      color: var(--text-secondary);
      font-weight: 500;
      margin-top: 0.2rem;
    }
    .hero-stats {
      display: flex;
      justify-content: center;
      gap: 1.5rem;
      margin-top: 2rem;
      flex-wrap: wrap;
    }
    .stat {
      background: rgba(255, 255, 255, 0.5);
      backdrop-filter: blur(6px);
      padding: 0.6rem 1.8rem;
      border-radius: 40px;
      font-weight: 600;
      font-size: 0.95rem;
      color: var(--text-secondary);
      border: 1px solid rgba(255, 255, 255, 0.6);
    }
    .stat strong {
      color: var(--primary);
    }

    /* ─────────── Buttons ─────────── */
    .cta-bar {
      display: flex;
      justify-content: center;
      gap: 1rem;
      margin-bottom: 2.5rem;
      flex-wrap: wrap;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.9rem 2.2rem;
      border: none;
      border-radius: 60px;
      font-weight: 600;
      font-size: 1rem;
      cursor: pointer;
      transition: all var(--transition);
      text-decoration: none;
      background: rgba(255, 255, 255, 0.7);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.3);
      color: var(--text-primary);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
    }
    .btn-primary {
      background: var(--primary);
      color: #fff;
      border-color: var(--primary);
    }
    .btn-primary:hover {
      background: #4338ca;
      transform: translateY(-3px) scale(1.02);
      box-shadow: 0 12px 32px rgba(79, 70, 229, 0.3);
    }
    .btn-outline {
      background: transparent;
      border: 2px solid var(--primary);
      color: var(--primary);
    }
    .btn-outline:hover {
      background: var(--primary);
      color: #fff;
      transform: translateY(-3px);
      box-shadow: 0 12px 32px rgba(79, 70, 229, 0.2);
    }

    /* ─────────── Section titles ─────────── */
    .section-title {
      font-size: 1.8rem;
      font-weight: 700;
      margin-bottom: 1.5rem;
      display: flex;
      align-items: center;
      gap: 0.6rem;
      color: var(--text-primary);
    }
    .section-title span {
      background: linear-gradient(135deg, var(--primary), var(--primary-light));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    /* ─────────── Cards grid ─────────── */
    .card-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.5rem;
      margin-bottom: 2.5rem;
    }
    .product-card {
      padding: 1.8rem;
      background: var(--glass-bg);
      backdrop-filter: blur(8px);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius);
      box-shadow: var(--glass-shadow);
      transition: all var(--transition);
      opacity: 0;
      animation: fadeSlideUp 0.7s ease forwards;
    }
    .product-card:hover {
      transform: translateY(-6px) scale(1.01);
      box-shadow: 0 20px 48px rgba(0, 0, 0, 0.08);
      border-color: rgba(79, 70, 229, 0.2);
    }
    .product-card .card-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 0.8rem;
      margin-bottom: 0.8rem;
      flex-wrap: wrap;
    }
    .badge {
      background: rgba(79, 70, 229, 0.1);
      color: var(--primary);
      padding: 0.2rem 1rem;
      border-radius: 30px;
      font-size: 0.75rem;
      font-weight: 600;
      white-space: nowrap;
      border: 1px solid rgba(79, 70, 229, 0.1);
    }
    .card-title {
      font-weight: 700;
      font-size: 1.15rem;
      margin-bottom: 0.2rem;
    }
    .card-subtitle {
      color: var(--text-secondary);
      font-size: 0.9rem;
      margin-bottom: 0.6rem;
    }
    .card-desc {
      color: var(--text-secondary);
      font-size: 0.95rem;
      line-height: 1.7;
    }

    /* ─────────── Skill bars ─────────── */
    .specs-container {
      padding: 2rem;
      background: var(--glass-bg);
      backdrop-filter: blur(8px);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius);
      box-shadow: var(--glass-shadow);
      margin-bottom: 2.5rem;
      transition: all var(--transition);
    }
    .specs-container:hover {
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.06);
    }
    .spec-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.9rem 0;
      border-bottom: 1px solid rgba(0, 0, 0, 0.04);
      flex-wrap: wrap;
      gap: 0.6rem;
    }
    .spec-item:last-child {
      border-bottom: none;
    }
    .spec-item span:first-child {
      font-weight: 500;
    }
    .progress-bar {
      width: 140px;
      height: 8px;
      background: rgba(0, 0, 0, 0.06);
      border-radius: 20px;
      overflow: hidden;
    }
    .progress-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--primary), var(--primary-light));
      border-radius: 20px;
      width: 0;
      animation: growWidth 1.2s ease forwards;
    }

    /* ─────────── Achievements grid ─────────── */
    .reviews-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1.2rem;
      margin-bottom: 2.5rem;
    }
    .review-card {
      padding: 1.5rem;
      background: var(--glass-bg);
      backdrop-filter: blur(8px);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius);
      box-shadow: var(--glass-shadow);
      transition: all var(--transition);
      text-align: center;
    }
    .review-card:hover {
      transform: scale(1.03) rotate(0.5deg);
      border-color: rgba(79, 70, 229, 0.2);
    }
    .review-icon {
      font-size: 2rem;
      margin-bottom: 0.5rem;
      display: block;
    }

    /* ─────────── Social bar ─────────── */
    .social-bar {
      display: flex;
      justify-content: center;
      gap: 1.2rem;
      flex-wrap: wrap;
      margin: 2rem 0;
    }
    .social-icon {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.7rem 1.6rem;
      background: var(--glass-bg);
      backdrop-filter: blur(8px);
      border: 1px solid var(--glass-border);
      border-radius: 60px;
      text-decoration: none;
      color: var(--text-primary);
      font-weight: 500;
      transition: all var(--transition);
      box-shadow: var(--glass-shadow);
    }
    .social-icon:hover {
      background: var(--primary);
      color: #fff;
      transform: translateY(-4px);
      box-shadow: 0 12px 32px rgba(79, 70, 229, 0.25);
      border-color: var(--primary);
    }

    /* ─────────── Footer ─────────── */
    .footer {
      text-align: center;
      padding: 2rem 0;
      color: var(--text-secondary);
      font-size: 0.9rem;
      opacity: 0.7;
    }

    /* ─────────── Responsive ─────────── */
    @media (max-width: 640px) {
      body { padding: 1rem; }
      .hero { padding: 2rem 1.2rem; }
      .btn { width: 100%; justify-content: center; }
      .spec-item { flex-direction: column; align-items: flex-start; }
      .progress-bar { width: 100%; }
    }

    /* ─────────── Print styles ─────────── */
    @media print {
      body {
        background: white !important;
        padding: 0.5in;
      }
      .glass, .product-card, .specs-container, .review-card {
        background: white !important;
        backdrop-filter: none !important;
        border: 1px solid #ddd !important;
        box-shadow: none !important;
        transform: none !important;
      }
      .cta-bar, .social-bar, .footer { display: none; }
      .avatar { animation: none !important; }
      .progress-fill { animation: none !important; width: 100% !important; }
    }
  </style>
</head>
<body>
<div class="container">

  <!-- ═══ HERO ═══ -->
  <div class="hero glass animate-in">
    <div class="hero-content">
      <div class="avatar">
        <%= (profile?.personal?.firstName?.[0] || '') + (profile?.personal?.lastName?.[0] || '') %>
      </div>
      <h1 class="name"><%= profile?.personal?.firstName || '' %> <%= profile?.personal?.lastName || '' %></h1>
      <% if (profile?.personal?.jobTitle) { %>
        <p class="title"><%= profile.personal.jobTitle %></p>
      <% } %>
      <div class="hero-stats">
        <% if (profile?.experience?.length) { %>
          <div class="stat">💼 <strong><%= profile.experience.length %></strong> Experiences</div>
        <% } %>
        <% if (profile?.skills?.length) { %>
          <div class="stat">⚡ <strong><%= profile.skills.length %></strong> Skills</div>
        <% } %>
        <% if (profile?.education?.length) { %>
          <div class="stat">🎓 <strong><%= profile.education.length %></strong> Degrees</div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- ═══ CTA ═══ -->
  <div class="cta-bar animate-in delay-1">
    <button class="btn btn-primary" onclick="window.print()">🖨️ Download Resume</button>
    <% if (profile?.contact?.email) { %>
      <a href="mailto:<%= profile.contact.email %>" class="btn btn-outline">✉️ Hire Me</a>
    <% } %>
  </div>

  <!-- ═══ CAREER OBJECTIVE ═══ -->
  <% if (profile?.careerObjective) { %>
    <div class="animate-in delay-2">
      <h2 class="section-title">🎯 <span>Career Objective</span></h2>
      <div class="specs-container">
        <p style="font-size: 1.05rem; line-height: 1.8; color: var(--text-primary);">
          <%= profile.careerObjective %>
        </p>
      </div>
    </div>
  <% } %>

  <!-- ═══ EXPERIENCE ═══ -->
  <% if (profile?.experience?.length) { %>
    <div class="animate-in delay-3">
      <h2 class="section-title">💼 <span>Experience</span></h2>
      <div class="card-grid">
        <% profile.experience.forEach(function(exp, index) { %>
          <div class="product-card" style="animation-delay: <%= 0.08 * (index + 1) %>s;">
            <div class="card-header">
              <span class="card-title"><%= exp.title || 'Untitled' %></span>
              <span class="badge"><%= exp.startDate || '' %><% if (exp.startDate && exp.endDate) { %> – <% } %><%= exp.endDate || 'Present' %></span>
            </div>
            <div class="card-subtitle"><%= exp.company || '' %></div>
            <% if (exp.description) { %>
              <p class="card-desc"><%= exp.description %></p>
            <% } %>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>

  <!-- ═══ EDUCATION ═══ -->
  <% if (profile?.education?.length) { %>
    <div class="animate-in delay-4">
      <h2 class="section-title">🎓 <span>Education</span></h2>
      <div class="card-grid">
        <% profile.education.forEach(function(edu, index) { %>
          <div class="product-card" style="animation-delay: <%= 0.08 * (index + 1) %>s;">
            <div class="card-title"><%= edu.degree || 'Degree' %></div>
            <div class="card-subtitle"><%= edu.institution || '' %></div>
            <span class="badge"><%= edu.startDate || '' %><% if (edu.startDate && edu.endDate) { %> – <% } %><%= edu.endDate || 'Present' %></span>
            <% if (edu.field) { %>
              <p class="card-desc"><%= edu.field %></p>
            <% } %>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>

  <!-- ═══ SKILLS ═══ -->
  <% if (profile?.skills?.length) { %>
    <div class="animate-in delay-5">
      <h2 class="section-title">⚙️ <span>Skills &amp; Expertise</span></h2>
      <div class="specs-container">
        <% profile.skills.forEach(function(skill) { 
          var pWidth = '25%';
          var prof = (skill.proficiency || 'Intermediate').toLowerCase();
          if (prof === 'expert' || prof === 'advanced') pWidth = '95%';
          else if (prof === 'intermediate') pWidth = '50%';
          else if (prof === 'beginner') pWidth = '25%';
        %>
          <div class="spec-item">
            <span><%= skill.skillName || 'Skill' %></span>
            <div style="display:flex;align-items:center;gap:0.8rem;flex-wrap:wrap;">
              <div class="progress-bar">
                <div class="progress-fill" style="animation-delay: 0.3s; width: <%= pWidth %>;"></div>
              </div>
              <span style="font-size:0.8rem; min-width:70px; opacity:0.7;"><%= skill.proficiency || 'Intermediate' %></span>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>

  <!-- ═══ PROJECTS ═══ -->
  <% if (profile?.projects?.length) { %>
    <div class="animate-in delay-5">
      <h2 class="section-title">🚀 <span>Projects</span></h2>
      <div class="card-grid">
        <% profile.projects.forEach(function(proj) { %>
          <div class="product-card">
            <div class="card-title"><%= proj.name || 'Project' %></div>
            <% if (proj.description) { %>
              <p class="card-desc"><%= proj.description %></p>
            <% } %>
            <% if (proj.link) { %>
              <a href="<%= proj.link %>" target="_blank" class="btn btn-outline" style="margin-top:0.8rem; display:inline-flex;">View Project →</a>
            <% } %>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>

  <!-- ═══ CERTIFICATES ═══ -->
  <% if (profile?.certificates?.length) { %>
    <div class="animate-in delay-5">
      <h2 class="section-title">📜 <span>Certificates</span></h2>
      <div class="card-grid">
        <% profile.certificates.forEach(function(cert) { %>
          <div class="product-card">
            <div class="card-title"><%= cert.name || 'Certificate' %></div>
            <div class="card-subtitle"><%= cert.issuer || '' %></div>
            <% if (cert.date) { %>
              <span class="badge"><%= cert.date %></span>
            <% } %>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>

  <!-- ═══ ACHIEVEMENTS ═══ -->
  <% if (profile?.achievements?.length) { %>
    <div class="animate-in delay-5">
      <h2 class="section-title">🏆 <span>Achievements</span></h2>
      <div class="reviews-grid">
        <% profile.achievements.forEach(function(ach) { %>
          <div class="review-card">
            <span class="review-icon">⭐</span>
            <div><%= ach.title || 'Achievement' %></div>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>

  <!-- ═══ LANGUAGES ═══ -->
  <% if (profile?.languages?.length) { %>
    <div class="animate-in delay-5">
      <h2 class="section-title">🌐 <span>Languages</span></h2>
      <div class="specs-container">
        <% profile.languages.forEach(function(lang) { %>
          <div class="spec-item">
            <span><%= lang.language || 'Language' %></span>
            <span class="badge"><%= lang.proficiency || 'Fluent' %></span>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>

  <!-- ═══ SOCIAL LINKS ═══ -->
  <% if (profile?.social && (profile.social.linkedin || profile.social.github || profile.social.portfolio || profile.social.website)) { %>
    <div class="animate-in delay-5">
      <h2 class="section-title">🔗 <span>Connect</span></h2>
      <div class="social-bar">
        <% if (profile.social.linkedin) { %>
          <a href="<%= profile.social.linkedin %>" target="_blank" class="social-icon">🔗 LinkedIn</a>
        <% } %>
        <% if (profile.social.github) { %>
          <a href="<%= profile.social.github %>" target="_blank" class="social-icon">💻 GitHub</a>
        <% } %>
        <% if (profile.social.portfolio) { %>
          <a href="<%= profile.social.portfolio %>" target="_blank" class="social-icon">🌍 Portfolio</a>
        <% } %>
        <% if (profile.social.website) { %>
          <a href="<%= profile.social.website %>" target="_blank" class="social-icon">🌐 Website</a>
        <% } %>
      </div>
    </div>
  <% } %>

  <div class="footer">Made with ❤️ using <strong>Resume.dev</strong></div>
</div>
</body>
</html>